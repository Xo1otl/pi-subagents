{
	"compilerOptions": {
		"target": "ES2023",
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"allowImportingTsExtensions": true,
		"noEmit": true,
		"skipLibCheck": true,
		"types": ["bun"]
	},
	"include": [
		"index.ts",
		"agent/**/*.ts",
		"runtime/**/*.ts",
		"ui/**/*.ts",
		"tests/**/*.ts"
	]
}
